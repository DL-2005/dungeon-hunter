extends Node

## GameManager.gd
## Autoload singleton (add via Project Settings > Autoload).
## Central place for fight tracking, run state, and later: calling into the
## enchant recommender lookup table (Week 9-10).

var current_run_seed: int = 0
var _fight_start_time: float = 0.0
var last_skill_tier: String = "Average"
var attempts_this_boss: int = 1
var currency: int = 0 
var equipped_enchant: String = ""

const FIGHT_LOG_PATH := "user://fight_logs.json"

#currency on shop UI 
func add_currency(amount: int) -> void:
	currency+=amount
	print("Gained: ", amount, "gold. Total: ", currency)

func equip_enchant(enchant_name: String) -> void:
	equipped_enchant = enchant_name
	print("Equipped enchant: ", enchant_name)

# Placeholder for the exported k-NN decision table (Week 9-10).
# Will be loaded from res://data/enchant_lookup.json once generated by the
# Python training script.
var enchant_lookup: Dictionary = {}


func _ready() -> void:
	randomize()
	current_run_seed = randi()
	_load_enchant_lookup()


func start_fight() -> void:
	_fight_start_time = Time.get_ticks_msec() / 1000.0

func get_fight_duration() -> float:
	return (Time.get_ticks_msec() / 1000.0) - _fight_start_time

func end_fight(player: Node) -> Dictionary:
	var duration := (Time.get_ticks_msec() / 1000.0) - _fight_start_time
	var profile: Dictionary = player.get_playstyle_profile(duration)
	print("Fight ended. Player profile: ", profile)
	return profile


func _load_enchant_lookup() -> void:
	var path := "res://data/enchant_lookup.json"
	if not FileAccess.file_exists(path):
		print("Enchant lookup table not found yet (expected until Week 9-10).")
		return
	var file := FileAccess.open(path, FileAccess.READ)
	var content := file.get_as_text()
	var parsed = JSON.parse_string(content)
	if parsed != null:
		enchant_lookup = parsed
		print("Loaded enchant lookup table with ", enchant_lookup.get("dataset", []).size(), " entries.")
# --- Real fight-data logging (Week 9-10) ---
# Add these pieces into the EXISTING GameManager.gd -- don't replace the
# whole file. This integrates with your existing start_fight()/end_fight().
#
# GameManager already tracks fight duration via _fight_start_time and
# builds `profile` (dodge_rate, hit_taken_rate, avg_fight_duration,
# damage_dealt_avg) inside end_fight(). This just adds:
#   1. an `attempts` counter (per-boss, resets on victory or new boss)
#   2. writing the completed profile + attempts to user://fight_logs.json
#
# Logs persist across play sessions. To feed them into the Python merge
# script, copy the file out to your project folder as
# "player_fight_logs.json" and run merge_real_data.py.
#
# On Windows, user:// typically lives at:
#   %APPDATA%\Godot\app_userdata\Dungeon Hunter\fight_logs.json




func log_fight_result(profile: Dictionary) -> void:
	var entry := {
		"dodge_rate": profile["dodge_rate"],
		"hit_taken_rate": profile["hit_taken_rate"],
		"avg_fight_duration": profile["avg_fight_duration"],
		"damage_dealt_avg": profile["damage_dealt_avg"],
		"attempts": attempts_this_boss,
	}

	var logs: Array = []
	if FileAccess.file_exists(FIGHT_LOG_PATH):
		var read_file := FileAccess.open(FIGHT_LOG_PATH, FileAccess.READ)
		var parsed = JSON.parse_string(read_file.get_as_text())
		if parsed is Array:
			logs = parsed
		read_file.close()

	logs.append(entry)

	var write_file := FileAccess.open(FIGHT_LOG_PATH, FileAccess.WRITE)
	write_file.store_string(JSON.stringify(logs, "\t"))
	write_file.close()

	print("Logged fight result (", logs.size(), " total logged fights).")


